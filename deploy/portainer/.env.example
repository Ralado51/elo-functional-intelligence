# REFERENCE ONLY. Enter actual values in Portainer's stack environment UI.
# Never commit a populated .env. No image is published or verified by this file.
GHCR_NAMESPACE=ralado51
# Each value is exactly 64 lowercase hexadecimal characters, WITHOUT sha256:.
API_IMAGE_DIGEST=
FRONTEND_IMAGE_DIGEST=
POSTGRES16_IMAGE_DIGEST=

# Unique to this isolated stack. Arbitrary characters are URL-encoded at runtime.
POSTGRES_PASSWORD=
# One or more comma-separated username:bcrypt-hash records, not plaintext.
# In Portainer UI use literal single $ characters; do not add shell quotes or $$.
# A local .env file must single-quote the entire value to prevent interpolation.
DEMO_BASIC_AUTH_USERS=
TRAEFIK_ROUTE_PREFIX=elo-functional-demo

# Safe default: no provider requests. Enable only for synthetic fixtures.
ELO_INFERENCE_MODE=mock
ELO_SYNTHETIC_ONLY_ACK=false
RADEON_API_KEY=
RADEON_MODEL=DeepSeek-V4-Flash
